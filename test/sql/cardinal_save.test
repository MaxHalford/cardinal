# name: test/sql/cardinal_save.test
# description: models and keys learned from queries are saved in the database
# group: [sql]

require cardinal

load __TEST_DIR__/cardinal_save.db

statement ok
CREATE TABLE movies AS SELECT range AS id, range % 50 AS year FROM range(1000);

statement ok
CREATE TABLE casts AS SELECT range % 1000 AS movie_id, range % 3 AS role FROM range(5000);

statement ok
SET cardinal_background = false;

query I
SELECT count(*) FROM movies m, casts c WHERE m.id = c.movie_id AND m.year < 10 AND c.role = 1;
----
333

# The join taught a key, saved with the models.
query IIII
SELECT fk_table, fk_column, pk_table, pk_column FROM cardinal.keys;
----
casts	movie_id	movies	id

query II
SELECT table_name, count(*) FROM cardinal.columns GROUP BY ALL ORDER BY ALL;
----
casts	1
movies	2

# A new session finds them.
restart

query I
SELECT count(*) FROM cardinal.keys;
----
1
