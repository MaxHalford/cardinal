# name: test/sql/cardinal_save.test
# description: models and keys learned from queries are saved in the store
# group: [sql]

require cardinal

load __TEST_DIR__/cardinal_save.db

statement ok
SET cardinal_store = '__TEST_DIR__/cardinal_save_store.db';

statement ok
CREATE TABLE movies AS SELECT range AS id, range % 50 AS year FROM range(1000);

statement ok
CREATE TABLE casts AS SELECT range % 1000 AS movie_id, range % 3 AS role FROM range(5000);

query I
SELECT count(*) FROM movies m, casts c WHERE m.id = c.movie_id AND m.year < 10 AND c.role = 1;
----
333

# The join taught a key: movies counts the casts of each movie.
query III
SELECT table_name, row_count, columns FROM cardinal_models();
----
casts	5000	[movie_id, role]
movies	1000	['F(casts.movie_id)', year]

# A new session finds them.
restart

statement ok
SET cardinal_store = '__TEST_DIR__/cardinal_save_store.db';

query I
SELECT count(*) FROM cardinal_models();
----
2
