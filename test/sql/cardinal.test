# name: test/sql/cardinal.test
# description: base table estimates leave query results unchanged
# group: [sql]

require cardinal

statement ok
CREATE TABLE users AS SELECT range AS id, range % 10 AS score FROM range(1000);

statement ok
CREATE TABLE badges AS SELECT range % 100 AS user_id FROM range(5000);

query I
SELECT current_setting('cardinal_estimator');
----
fanout

statement ok
SET cardinal_estimator = 'exact';

# Range, equality and LIKE filters, joined.
query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score >= 5;
----
2500

query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score = 3 AND CAST(u.id AS VARCHAR) LIKE '%3';
----
500

# Unsatisfiable filters.
query I
SELECT count(*) FROM users WHERE score > 10;
----
0

# A model for users.score: 10 equally likely values.
statement ok
CREATE SCHEMA __cardinal;

statement ok
CREATE TABLE __cardinal.tables AS SELECT 'users' AS table_name, 1000 AS row_count;

statement ok
CREATE TABLE __cardinal.columns AS SELECT 'users' AS table_name, 'score' AS column_name, NULL::VARCHAR AS parent, NULL::BIGINT AS members;

statement ok
CREATE TABLE __cardinal.states AS SELECT 'users' AS table_name, 'score' AS column_name, range::INTEGER AS state, range::VARCHAR AS value, 'value' AS kind FROM range(10);

statement ok
CREATE TABLE __cardinal.probabilities AS SELECT 'users' AS table_name, 'score' AS column_name, range::INTEGER AS state, NULL::INTEGER AS parent_state, 0.1 AS probability FROM range(10);

statement ok
SET cardinal_background = false;

statement ok
SET cardinal_estimator = 'bn';

query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score >= 5;
----
2500

# OR across columns: inclusion-exclusion.
query I
SELECT count(*) FROM users u WHERE u.score = 1 OR u.id < 10;
----
109

# badges has no model: DuckDB's estimate.
query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND b.user_id < 50;
----
2500
