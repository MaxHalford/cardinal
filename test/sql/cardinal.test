# name: test/sql/cardinal.test
# description: estimates leave query results unchanged
# group: [sql]

require cardinal

statement ok
CREATE TABLE users AS SELECT range AS id, range % 10 AS score FROM range(1000);

statement ok
CREATE TABLE badges AS SELECT range % 100 AS user_id FROM range(5000);

query I
SELECT current_setting('cardinal_estimator');
----
on

# A typo is an error, not cardinal silently off.
statement error
SET cardinal_estimator = 'of';
----
Invalid Input Error: cardinal_estimator must be one of 'on', 'off', 'bn', 'exact'

statement ok
SET cardinal_estimator = 'exact';

# Range, equality and LIKE filters, joined.
query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score >= 5;
----
2500

query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score = 3 AND CAST(u.id AS VARCHAR) LIKE '%3';
----
500

# Unsatisfiable filters.
query I
SELECT count(*) FROM users WHERE score > 10;
----
0

# Models fitted when queries need them, in memory: this database has no file.
statement ok
SET cardinal_background = false;

statement ok
SET cardinal_estimator = 'bn';

query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score >= 5;
----
2500

# IN: 3 of 10 scores, then 1. DuckDB alone guesses 20%: 200 rows.
query II
EXPLAIN SELECT * FROM users WHERE score IN (1, 2, 3);
----
physical_plan	<REGEX>:.*~300 rows.*

query II
EXPLAIN SELECT * FROM users WHERE score IN (3) OR id < 0;
----
physical_plan	<REGEX>:.*~100 rows.*

# OR across columns: inclusion-exclusion.
query I
SELECT count(*) FROM users u WHERE u.score = 1 OR u.id < 10;
----
109

# A join on a filtered key column.
query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND b.user_id < 50;
----
2500

statement ok
SET cardinal_estimator = 'on';

query I
SELECT count(*) FROM users u, badges b WHERE b.user_id = u.id AND u.score >= 5 AND b.user_id < 50;
----
1250

# In memory: nothing saved.
query I
SELECT count(*) FROM cardinal_models();
----
0
