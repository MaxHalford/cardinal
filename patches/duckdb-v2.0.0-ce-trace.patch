 }
 
+void CardinalityEstimator::TraceTotalDomains() {
+	if (!CETrace::Enabled()) {
+		return;
+	}
+	for (auto &total_domain : state->relation_set_stats) {
+		string columns = "[";
+		bool first = true;
+		for (auto &binding : total_domain.equivalent_relations) {
+			columns += string(first ? "" : ",") + "[" + to_string(binding.table_index.index) + "," +
+			           to_string(binding.column_index.GetIndex()) + "]";
+			first = false;
+		}
+		string filters = "[";
+		for (idx_t i = 0; i < total_domain.predicates.size(); i++) {
+			filters += string(i ? "," : "") + to_string(total_domain.predicates[i].get().GetFilter().filter_index);
+		}
+		// v2 domains: hll = the HLL/exact distinct count, no_hll = the min-max or cardinality fallback
+		auto &domain = total_domain.domain_estimate;
+		auto has_hll = domain.HasReliableDistinctCount();
+		auto hll = has_hll ? domain.GetReliableDistinctCount() : 0;
+		auto distinct = domain.GetDistinctCount();
+		auto no_hll = has_hll || distinct == NumericLimits<idx_t>::Maximum() ? string("null") : to_string(distinct);
+		CETrace::WriteLine("{\"ev\":\"tdom\",\"inv\":" + to_string(CETrace::CurrentInvocation()) +
+		                   ",\"columns\":" + columns + "],\"filters\":" + filters +
+		                   "],\"has_hll\":" + (has_hll ? "true" : "false") + ",\"hll\":" + to_string(hll) +
+		                   ",\"no_hll\":" + no_hll + "}");
+	}
+}
