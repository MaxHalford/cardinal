+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/optimizer/join_order/ce_trace.hpp
+//
+// Research patch (cardinal-duck): logs every cardinality question asked by the
+// join order optimizer as JSON lines to the file named by $DUCKDB_CE_TRACE.
+// Logging only, it does not change any optimizer decision.
+//
+// With $DUCKDB_CE_INJECT, estimates are read from that file instead of being
+// computed, one per line: "<invocation> <relation list> <estimate>", e.g.
+// "1 [0,2] 1234.5". Questions missing from the file keep DuckDB's estimate.
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb/common/common.hpp"
+#include "duckdb/common/reference_map.hpp"
+
+namespace duckdb {
+
+class QueryGraphManager;
+class DPJoinNode;
+struct JoinRelationSet;
+
+class CETrace {
+public:
+	static bool Enabled();
+	//! Tracing or injecting: optimizer invocations get ids
+	static bool Active();
+	//! Injected estimate of a set in the current invocation, if any
+	static bool Inject(const JoinRelationSet &set, double &estimate);
+	static void WriteLine(const string &line);
+	static string Quote(const string &text);
+	static string Number(double value);
+	static string RelationList(const JoinRelationSet &set);
+	//! Id of the innermost active optimizer invocation (0 if none)
+	static idx_t CurrentInvocation();
+	//! Next sequence number of an event within the current invocation
+	static idx_t NextSequence();
+	//! Who asked the current question: "leaf", "cost_model" or "join_node"
+	static const char *&Caller();
+
+	static void Question(const JoinRelationSet &set, double estimate, bool cache_hit, double numerator,
+	                     double denominator, bool injected = false);
+	static void Phase(const string &name);
+	static void Graph(QueryGraphManager &query_graph_manager, bool reorderable, idx_t depth);
+	static void Plan(QueryGraphManager &query_graph_manager,
+	                 const reference_map_t<JoinRelationSet, unique_ptr<DPJoinNode>> &plans);
+};
+
+//! RAII scope for one JoinOrderOptimizer::Optimize call
+class CETraceInvocation {
+public:
+	CETraceInvocation();
+	~CETraceInvocation();
+};
+
+//! RAII scope that sets the caller tag of question events
+class CETraceCaller {
+public:
+	explicit CETraceCaller(const char *caller);
+	~CETraceCaller();
+
+private:
+	const char *previous;
+};
+
+} // namespace duckdb
