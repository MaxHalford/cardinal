+++ b/src/optimizer/join_order/ce_trace.cpp
@@ -0,0 +1,539 @@
+#include "duckdb/optimizer/join_order/ce_trace.hpp"
+
+#include "duckdb/catalog/catalog_entry/table_catalog_entry.hpp"
+#include "duckdb/common/enum_util.hpp"
+#include "duckdb/common/enums/join_type.hpp"
+#include "duckdb/common/enums/logical_operator_type.hpp"
+#include "duckdb/optimizer/join_order/join_node.hpp"
+#include "duckdb/optimizer/join_order/query_graph_manager.hpp"
+#include "duckdb/parser/keyword_helper.hpp"
+#include "duckdb/planner/expression/bound_columnref_expression.hpp"
+#include "duckdb/planner/expression/bound_conjunction_expression.hpp"
+#include "duckdb/planner/filter/expression_filter.hpp"
+#include "duckdb/planner/expression_iterator.hpp"
+#include "duckdb/planner/operator/logical_column_data_get.hpp"
+#include "duckdb/planner/operator/logical_comparison_join.hpp"
+#include "duckdb/planner/operator/logical_filter.hpp"
+#include "duckdb/planner/operator/logical_get.hpp"
+#include "duckdb/planner/table_filter.hpp"
+
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+
+namespace duckdb {
+
+namespace {
+
+struct TraceState {
+	std::mutex lock;
+	std::ofstream out;
+	bool enabled = false;
+	std::atomic<idx_t> next_invocation {1};
+};
+
+//! Estimates read from $DUCKDB_CE_INJECT, keyed by "<invocation> <relation list>"
+struct InjectState {
+	unordered_map<string, double> estimates;
+	bool enabled = false;
+};
+
+InjectState &GetInjectState() {
+	static InjectState *state = []() {
+		auto result = new InjectState();
+		auto path = std::getenv("DUCKDB_CE_INJECT");
+		if (!path || !*path) {
+			return result;
+		}
+		std::ifstream in(path);
+		string invocation, set;
+		double estimate;
+		while (in >> invocation >> set >> estimate) {
+			result->estimates[invocation + " " + set] = estimate;
+		}
+		result->enabled = true;
+		return result;
+	}();
+	return *state;
+}
+
+TraceState &GetState() {
+	static TraceState *state = []() {
+		auto result = new TraceState();
+		auto path = std::getenv("DUCKDB_CE_TRACE");
+		if (path && *path) {
+			result->out.open(path, std::ios::out | std::ios::app);
+			result->enabled = result->out.is_open();
+		}
+		return result;
+	}();
+	return *state;
+}
+
+struct InvocationFrame {
+	idx_t id;
+	idx_t sequence;
+};
+
+vector<InvocationFrame> &Frames() {
+	static thread_local vector<InvocationFrame> frames;
+	return frames;
+}
+
+//! Walk down the FILTER/LIMIT chain that the relation manager passes through
+LogicalOperator &BaseOperator(LogicalOperator &op, vector<LogicalOperatorType> &chain) {
+	reference<LogicalOperator> current = op;
+	while (current.get().children.size() == 1 && (current.get().type == LogicalOperatorType::LOGICAL_FILTER ||
+	                                               current.get().type == LogicalOperatorType::LOGICAL_LIMIT)) {
+		chain.push_back(current.get().type);
+		current = *current.get().children[0];
+	}
+	return current.get();
+}
+
+//! MARK join against a constant list: how DuckDB rewrites `x IN (c1, ..., cn)`, n >= 5
+bool IsInListJoin(LogicalOperator &op) {
+	if (op.type != LogicalOperatorType::LOGICAL_COMPARISON_JOIN) {
+		return false;
+	}
+	auto &join = op.Cast<LogicalComparisonJoin>();
+	return join.join_type == JoinType::MARK && join.conditions.size() == 1 && join.conditions[0].IsComparison() &&
+	       join.conditions[0].GetComparisonType() == ExpressionType::COMPARE_EQUAL &&
+	       join.children[1]->type == LogicalOperatorType::LOGICAL_CHUNK_GET;
+}
+
+//! A relation that is a table scan, possibly under filters and IN-list joins
+struct TableScan {
+	optional_ptr<LogicalGet> get;
+	//! Expressions left in FILTER operators. ExtractEdges has already moved the
+	//! others into query graph filters, except those it cannot bind (e.g. a mark
+	//! column projected away by its FILTER).
+	vector<reference<Expression>> filters;
+};
+
+bool FindTable(LogicalOperator &op, TableScan &scan) {
+	switch (op.type) {
+	case LogicalOperatorType::LOGICAL_FILTER:
+		for (auto &expr : op.expressions) {
+			scan.filters.push_back(*expr);
+		}
+		return FindTable(*op.children[0], scan);
+	case LogicalOperatorType::LOGICAL_GET:
+		scan.get = &op.Cast<LogicalGet>();
+		return op.children.empty() && scan.get->GetTable();
+	case LogicalOperatorType::LOGICAL_COMPARISON_JOIN:
+		return IsInListJoin(op) && FindTable(*op.children[0], scan);
+	default:
+		return false;
+	}
+}
+
+//! Operator in op's subtree that defines the bindings of table_index
+optional_ptr<LogicalOperator> FindDefinition(LogicalOperator &op, TableIndex table_index) {
+	if (op.type == LogicalOperatorType::LOGICAL_GET && op.Cast<LogicalGet>().table_index == table_index) {
+		return &op;
+	}
+	if (IsInListJoin(op) && op.Cast<LogicalComparisonJoin>().mark_index == table_index) {
+		return &op;
+	}
+	for (auto &child : op.children) {
+		auto result = FindDefinition(*child, table_index);
+		if (result) {
+			return result;
+		}
+	}
+	return nullptr;
+}
+
+string Alias(idx_t relation_id, const string &column) {
+	return "r" + to_string(relation_id) + "." + KeywordHelper::WriteOptionallyQuoted(column);
+}
+
+void RewriteColumnRefs(Expression &expr, const std::function<string(const ColumnBinding &)> &namer) {
+	if (expr.GetExpressionClass() == ExpressionClass::BOUND_COLUMN_REF) {
+		auto &colref = expr.Cast<BoundColumnRefExpression>();
+		colref.SetAlias(Identifier(namer(colref.Binding())));
+	}
+	ExpressionIterator::EnumerateChildren(expr, [&](Expression &child) { RewriteColumnRefs(child, namer); });
+}
+
+string ToSQL(const Expression &expr, const std::function<string(const ColumnBinding &)> &namer) {
+	auto copy = expr.Copy();
+	RewriteColumnRefs(*copy, namer);
+	return copy->ToString();
+}
+
+//! A binding as SQL: r<relation>.<column>, or `(lhs IN (...))` for an IN-list mark column
+string BindingName(QueryGraphManager &qgm, const vector<unique_ptr<SingleJoinRelation>> &relations,
+                   const ColumnBinding &binding) {
+	// Bindings projected away inside a relation are not in relation_mapping: search.
+	idx_t relation_id = DConstants::INVALID_INDEX;
+	optional_ptr<LogicalOperator> def;
+	auto entry = qgm.relation_manager.relation_mapping.find(binding.table_index);
+	for (idx_t i = 0; i < relations.size() && !def; i++) {
+		if (entry != qgm.relation_manager.relation_mapping.end() && entry->second.index != i) {
+			continue;
+		}
+		relation_id = i;
+		def = FindDefinition(relations[i]->op, binding.table_index);
+	}
+	if (relation_id == DConstants::INVALID_INDEX || (!def && entry == qgm.relation_manager.relation_mapping.end())) {
+		return "unmapped_" + to_string(binding.table_index.index) + "_" + to_string(binding.column_index.GetIndex());
+	}
+	auto fallback = Alias(relation_id, "col_" + to_string(binding.table_index.index) + "_" +
+	                                       to_string(binding.column_index.GetIndex()));
+	if (!def) {
+		return fallback;
+	}
+
+	if (def->type == LogicalOperatorType::LOGICAL_GET) {
+		auto &get = def->Cast<LogicalGet>();
+		auto &column_ids = get.GetColumnIds();
+		if (binding.column_index >= column_ids.size()) {
+			return fallback;
+		}
+		return Alias(relation_id, get.GetColumnName(column_ids[binding.column_index]).GetIdentifierName());
+	}
+
+	// IN-list mark column, e.g. (r3.keyword IN ('murder', 'blood'))
+	auto &join = def->Cast<LogicalComparisonJoin>();
+	auto namer = [&](const ColumnBinding &b) {
+		return BindingName(qgm, relations, b);
+	};
+	string values;
+	auto &collection = *join.children[1]->Cast<LogicalColumnDataGet>().collection;
+	for (auto &row : collection.Rows()) {
+		values += (values.empty() ? "" : ", ") + row.GetValue(0).ToSQLString();
+	}
+	return "(" + ToSQL(join.conditions[0].GetLHS(), namer) + " IN (" + values + "))";
+}
+
+//! A table filter as SQL, without its optional parts, e.g. x > 5 AND optional(...) -> x > 5
+string RequiredSQL(Expression &expr) {
+	if (expr.GetExpressionType() != ExpressionType::CONJUNCTION_AND) {
+		return expr.ToString();
+	}
+	auto copy = expr.Copy();
+	auto &children = copy->Cast<BoundConjunctionExpression>().GetChildrenMutable();
+	vector<unique_ptr<Expression>> required;
+	for (auto &child : children) {
+		if (!ExpressionFilter::IsOptionalExpression(*child)) {
+			required.push_back(std::move(child));
+		}
+	}
+	if (required.size() == 1) {
+		return required[0]->ToString();
+	}
+	children = std::move(required);
+	return copy->ToString();
+}
+
+string BindingJson(const ColumnBinding &binding) {
+	if (!binding.table_index.IsValid()) {
+		return "null";
+	}
+	return "[" + to_string(binding.table_index.index) + "," + to_string(binding.column_index.GetIndex()) + "]";
+}
+
+string OptionalSet(optional_ptr<JoinRelationSet> set) {
+	return set ? CETrace::RelationList(*set) : "null";
+}
+
+} // namespace
+
+bool CETrace::Enabled() {
+	return GetState().enabled;
+}
+
+bool CETrace::Active() {
+	return Enabled() || GetInjectState().enabled;
+}
+
+bool CETrace::Inject(const JoinRelationSet &set, double &estimate) {
+	auto &state = GetInjectState();
+	if (!state.enabled) {
+		return false;
+	}
+	auto entry = state.estimates.find(to_string(CurrentInvocation()) + " " + RelationList(set));
+	if (entry == state.estimates.end()) {
+		return false;
+	}
+	estimate = entry->second;
+	return true;
+}
+
+void CETrace::WriteLine(const string &line) {
+	auto &state = GetState();
+	std::lock_guard<std::mutex> guard(state.lock);
+	state.out << line << '\n';
+	state.out.flush();
+}
+
+string CETrace::Quote(const string &text) {
+	string result = "\"";
+	for (unsigned char c : text) {
+		switch (c) {
+		case '"':
+			result += "\\\"";
+			break;
+		case '\\':
+			result += "\\\\";
+			break;
+		case '\n':
+			result += "\\n";
+			break;
+		case '\r':
+			result += "\\r";
+			break;
+		case '\t':
+			result += "\\t";
+			break;
+		default:
+			if (c < 0x20) {
+				char buffer[8];
+				snprintf(buffer, sizeof(buffer), "\\u%04x", c);
+				result += buffer;
+			} else {
+				result += static_cast<char>(c);
+			}
+		}
+	}
+	return result + "\"";
+}
+
+string CETrace::Number(double value) {
+	if (!std::isfinite(value)) {
+		// JSON has no inf/nan: the generator treats a string here as an error
+		return Quote(std::to_string(value));
+	}
+	char buffer[32];
+	snprintf(buffer, sizeof(buffer), "%.17g", value);
+	return buffer;
+}
+
+string CETrace::RelationList(const JoinRelationSet &set) {
+	string result = "[";
+	for (idx_t i = 0; i < set.count; i++) {
+		result += (i ? "," : "") + to_string(set.relations[i].index);
+	}
+	return result + "]";
+}
+
+idx_t CETrace::CurrentInvocation() {
+	auto &frames = Frames();
+	return frames.empty() ? 0 : frames.back().id;
+}
+
+idx_t CETrace::NextSequence() {
+	auto &frames = Frames();
+	return frames.empty() ? 0 : frames.back().sequence++;
+}
+
+const char *&CETrace::Caller() {
+	static thread_local const char *caller = "cost_model";
+	return caller;
+}
+
+void CETrace::Question(const JoinRelationSet &set, double estimate, bool cache_hit, double numerator,
+                       double denominator, bool injected) {
+	string line = "{\"ev\":\"question\",\"inv\":" + to_string(CurrentInvocation()) +
+	              ",\"seq\":" + to_string(NextSequence()) + ",\"set\":" + RelationList(set) +
+	              ",\"est\":" + Number(estimate) + ",\"cache_hit\":" + (cache_hit ? "true" : "false") +
+	              ",\"caller\":" + Quote(Caller());
+	if (!cache_hit && denominator > 0) {
+		line += ",\"numerator\":" + Number(numerator) + ",\"denominator\":" + Number(denominator);
+	}
+	if (injected) {
+		line += ",\"injected\":true";
+	}
+	WriteLine(line + "}");
+}
+
+void CETrace::Phase(const string &name) {
+	if (!Enabled()) {
+		return;
+	}
+	WriteLine("{\"ev\":\"phase\",\"inv\":" + to_string(CurrentInvocation()) + ",\"seq\":" + to_string(NextSequence()) +
+	          ",\"name\":" + Quote(name) + "}");
+}
+
+void CETrace::Graph(QueryGraphManager &qgm, bool reorderable, idx_t depth) {
+	if (!Enabled()) {
+		return;
+	}
+	auto &frames = Frames();
+	idx_t parent = frames.size() >= 2 ? frames[frames.size() - 2].id : 0;
+	auto &relations = qgm.relation_manager.PeekRelations();
+	auto namer = [&](const ColumnBinding &binding) {
+		return BindingName(qgm, relations, binding);
+	};
+
+	// v2 keeps FILTER expressions above a relation that are also graph filters: listed once, as graph filters.
+	unordered_map<idx_t, unordered_set<string>> graph_filters;
+	if (reorderable) {
+		for (auto &info : qgm.GetFilterBindings()) {
+			if (info->filter && info->set.get().count == 1) {
+				graph_filters[info->set.get().relations[0].index].insert(ToSQL(*info->filter, namer));
+			}
+		}
+	}
+
+	string rels = "[";
+	for (idx_t rel_id = 0; rel_id < relations.size(); rel_id++) {
+		auto &relation = *relations[rel_id];
+		vector<LogicalOperatorType> chain;
+		auto &base = BaseOperator(relation.op, chain);
+		TableScan scan;
+		auto get = FindTable(relation.op, scan) ? scan.get : nullptr;
+
+		string rel = "{\"id\":" + to_string(rel_id) + ",\"kind\":" + Quote(get ? "table" : "derived") +
+		             ",\"op\":" + Quote(LogicalOperatorToString(base.type));
+		string chain_json = "[";
+		for (idx_t i = 0; i < chain.size(); i++) {
+			chain_json += (i ? "," : "") + Quote(LogicalOperatorToString(chain[i]));
+		}
+		rel += ",\"chain\":" + chain_json + "]";
+
+		if (get) {
+			auto &table = *get->GetTable();
+			rel += ",\"catalog\":" + Quote(table.ParentCatalog().GetName().GetIdentifierName()) +
+			       ",\"schema\":" + Quote(table.ParentSchema().name.GetIdentifierName()) +
+			       ",\"table\":" + Quote(table.name.GetIdentifierName());
+			if (get->function.cardinality) {
+				auto node_stats = get->function.cardinality(qgm.context, get->bind_data.get());
+				if (node_stats && node_stats->has_estimated_cardinality) {
+					rel += ",\"base_rows\":" + to_string(node_stats->estimated_cardinality);
+				}
+			}
+			string filters = "[";
+			bool first = true;
+			for (auto &entry : get->table_filters) {
+				auto &column_index = get->GetColumnIndex(entry.GetIndex());
+				auto column_name = get->GetColumnName(column_index).GetIdentifierName();
+				// v2 filters are all expression filters: optional ones keep the v1 type name.
+				auto optional = ExpressionFilter::IsOptionalFilter(entry.Filter());
+				auto type = optional ? string("OPTIONAL_FILTER") : EnumUtil::ToString(entry.Filter().filter_type);
+				string sql = "null";
+				try {
+					BoundColumnRefExpression colref(Identifier(Alias(rel_id, column_name)),
+					                                get->GetColumnType(column_index),
+					                                ColumnBinding(get->table_index, ProjectionIndex(0)));
+					sql = Quote(RequiredSQL(*entry.Filter().ToExpression(colref)));
+				} catch (std::exception &) {
+				}
+				filters += string(first ? "" : ",") + "{\"column\":" + Quote(column_name) +
+				           ",\"type\":" + Quote(type) + ",\"sql\":" + sql + "}";
+				first = false;
+			}
+			rel += ",\"table_filters\":" + filters + "]";
+			string scan_filters = "[";
+			bool first_filter = true;
+			for (auto &expr : scan.filters) {
+				auto sql = ToSQL(expr.get(), namer);
+				if (graph_filters[rel_id].count(sql)) {
+					continue;
+				}
+				scan_filters += string(first_filter ? "" : ",") + Quote(sql);
+				first_filter = false;
+			}
+			rel += ",\"filters\":" + scan_filters + "]";
+		}
+
+		auto &stats = relation.stats;
+		rel += ",\"est\":" + to_string(stats.cardinality) + ",\"filter_strength\":" + Number(stats.filter_strength);
+		string columns = "[";
+		for (idx_t i = 0; i < stats.columns.size(); i++) {
+			auto &column = stats.columns[i];
+			auto source = column.distinct_count.source;
+			auto from_hll = source == DistinctCountSource::HLL || source == DistinctCountSource::EXACT;
+			columns += string(i ? "," : "") + "{\"name\":" + Quote(column.name.GetIdentifierName()) +
+			           ",\"ndv\":" + to_string(column.distinct_count.distinct_count) +
+			           ",\"from_hll\":" + (from_hll ? "true" : "false") +
+			           ",\"source\":" + Quote(EnumUtil::ToString(source)) + "}";
+		}
+		rel += ",\"columns\":" + columns + "]}";
+		rels += string(rel_id ? "," : "") + rel;
+	}
+	rels += "]";
+
+	string filters = "[";
+	if (reorderable) {
+		auto &filter_infos = qgm.GetFilterBindings();
+		for (idx_t i = 0; i < filter_infos.size(); i++) {
+			auto &info = *filter_infos[i];
+			string sql = "null";
+			if (info.filter) {
+				sql = Quote(ToSQL(*info.filter, namer));
+			}
+			filters += string(i ? "," : "") + "{\"index\":" + to_string(info.filter_index) +
+			           ",\"set\":" + RelationList(info.set.get()) + ",\"left_set\":" + OptionalSet(info.left_set) +
+			           ",\"right_set\":" + OptionalSet(info.right_set) +
+			           ",\"join_type\":" + Quote(JoinTypeToString(info.join_type)) +
+			           ",\"left_binding\":" + BindingJson(info.left_binding) +
+			           ",\"right_binding\":" + BindingJson(info.right_binding) + ",\"sql\":" + sql + "}";
+		}
+	}
+	filters += "]";
+
+	WriteLine("{\"ev\":\"invocation\",\"inv\":" + to_string(CurrentInvocation()) + ",\"parent\":" + to_string(parent) +
+	          ",\"depth\":" + to_string(depth) + ",\"reorderable\":" + (reorderable ? "true" : "false") +
+	          ",\"relations\":" + rels + ",\"filters\":" + filters + "}");
+}
+
+namespace {
+
+string PlanJson(const reference_map_t<JoinRelationSet, unique_ptr<DPJoinNode>> &plans, JoinRelationSet &set) {
+	if (set.count == 1) {
+		return to_string(set.relations[0].index);
+	}
+	auto entry = plans.find(set);
+	if (entry == plans.end()) {
+		return "null";
+	}
+	auto &node = *entry->second;
+	return "{\"set\":" + CETrace::RelationList(set) + ",\"est\":" + to_string(node.cardinality) +
+	       ",\"cost\":" + CETrace::Number(node.cost) + ",\"left\":" + PlanJson(plans, node.left_set) +
+	       ",\"right\":" + PlanJson(plans, node.right_set) + "}";
+}
+
+} // namespace
+
+void CETrace::Plan(QueryGraphManager &qgm, const reference_map_t<JoinRelationSet, unique_ptr<DPJoinNode>> &plans) {
+	if (!Enabled()) {
+		return;
+	}
+	unordered_set<RelationIndex> bindings;
+	for (idx_t i = 0; i < qgm.relation_manager.NumRelations(); i++) {
+		bindings.emplace(i);
+	}
+	auto &total = qgm.set_manager.GetJoinRelation(bindings);
+	WriteLine("{\"ev\":\"plan\",\"inv\":" + to_string(CurrentInvocation()) + ",\"seq\":" + to_string(NextSequence()) +
+	          ",\"tree\":" + PlanJson(plans, total) + "}");
+}
+
+CETraceInvocation::CETraceInvocation() {
+	if (!CETrace::Active()) {
+		return;
+	}
+	Frames().push_back({GetState().next_invocation++, 0});
+}
+
+CETraceInvocation::~CETraceInvocation() {
+	if (!CETrace::Active()) {
+		return;
+	}
+	Frames().pop_back();
+}
+
+CETraceCaller::CETraceCaller(const char *caller) : previous(CETrace::Caller()) {
+	CETrace::Caller() = caller;
+}
+
+CETraceCaller::~CETraceCaller() {
+	CETrace::Caller() = previous;
+}
