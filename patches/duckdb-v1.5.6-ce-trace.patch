+void CardinalityEstimator::TraceTotalDomains() {
+	if (!CETrace::Enabled()) {
+		return;
+	}
+	for (auto &total_domain : relation_set_stats) {
+		string columns = "[";
+		bool first = true;
+		for (auto &binding : total_domain.equivalent_relations) {
+			columns += string(first ? "" : ",") + "[" + to_string(binding.table_index) + "," +
+			           to_string(binding.column_index) + "]";
+			first = false;
+		}
+		string filters = "[";
+		for (idx_t i = 0; i < total_domain.filters.size(); i++) {
+			filters += string(i ? "," : "") + to_string(total_domain.filters[i]->filter_index);
+		}
+		auto no_hll = total_domain.distinct_count_no_hll == NumericLimits<idx_t>::Maximum()
+		                  ? string("null")
+		                  : to_string(total_domain.distinct_count_no_hll);
+		CETrace::WriteLine("{\"ev\":\"tdom\",\"inv\":" + to_string(CETrace::CurrentInvocation()) +
+		                   ",\"columns\":" + columns + "],\"filters\":" + filters +
+		                   "],\"has_hll\":" + (total_domain.has_distinct_count_hll ? "true" : "false") +
+		                   ",\"hll\":" + to_string(total_domain.distinct_count_hll) + ",\"no_hll\":" + no_hll + "}");
+	}
+}
